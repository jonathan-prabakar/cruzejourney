{
  "name": "cruze-journey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/lib/integration/__tests__",
    "intelligence:live": "RUN_GEMMA_LIVE=1 vitest run src/lib/intelligence/__tests__/live.test.ts",
    "test:e2e": "playwright test",
    "maps:refresh": "node scripts/refresh-road-data.mjs",
    "intelligence:live:browser": "RUN_GEMMA_BROWSER_LIVE=1 playwright test e2e/gemma-live.spec.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "lucide-react": "^0.548.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "react-test-renderer": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
